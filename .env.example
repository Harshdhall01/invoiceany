# Solana network for the wallet adapter: devnet | testnet | mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# Optional custom RPC (defaults to the public cluster URL for the network above)
# NEXT_PUBLIC_SOLANA_RPC_URL=

# Payment provider: mock | aurora  (keep "mock" until the Aurora preflight passes)
PAYMENT_PROVIDER=mock
# Mirror of the above, only used to show the "simulate payment" dev panel on /pay/[id]
NEXT_PUBLIC_PAYMENT_PROVIDER=mock

# ---- Aurora Intents (server-side only, never prefix with NEXT_PUBLIC_) ----
AURORA_API_KEY=
AURORA_BASE_URL=https://intents-api.aurora.dev
# assetId of USDC on Solana. Leave empty, run scripts/aurora-dry-run.ts, then paste the value it prints.
AURORA_DESTINATION_ASSET_ID=
QUOTE_DEADLINE_MINUTES=60
# EXACT_OUTPUT = freelancer receives exactly the invoice amount in USDC
AURORA_SWAP_TYPE=EXACT_OUTPUT
# Slippage in basis points (100 = 1%)
AURORA_SLIPPAGE_BPS=100

# ---- Dev only: real-test debugging (Step E) ----
# 1 = write raw Aurora quote/status responses to .debug/aurora-<invoiceId>.jsonl (git-ignored)
DEBUG_AURORA=0
# 1 = show the "Debug details" expander on the pay page (same value as above)
NEXT_PUBLIC_DEBUG_AURORA=0

# Used by scripts/preflight.ts and scripts/aurora-dry-run.ts
# DRY_RUN_RECIPIENT=<your Solana address>
# DRY_RUN_REFUND_TO=<your own 0x address on Base>
